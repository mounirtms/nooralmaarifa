rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gallery uploads are publicly readable so images render on the site
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == 'mounir.webdev.tms@gmail.com';
    }

    // Everything else: deny writes, allow public reads of static assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
